# Copy this file to .env and change every value marked CHANGE-ME.

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SANADEX_SECRET=CHANGE-ME-run-the-command-above

# Secret used to sign licence keys. Keep it private; if you change it,
# previously generated keys stop validating.
SANADEX_LICENSE_SECRET=CHANGE-ME-licence-signing-secret

# 8000 is the app port. Behind nginx/Caddy keep the container bound to
# 127.0.0.1 and never expose this port directly to the internet.
PORT=8000
HOST=0.0.0.0
WEB_THREADS=8

# Only set this for debugging; it prints tracebacks to administrators.
# SANADEX_DEBUG=1

# Microsoft SQL Server (optional). Also requires pyodbc + an ODBC driver.
# SANADEX_DB=mssql
# SANADEX_MSSQL_DSN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=sql.example.com;DATABASE=Sanadex;UID=sa;PWD=secret;TrustServerCertificate=yes
